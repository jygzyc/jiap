  "engines": [
    {
      "id": "jvm",
      "description": "decx-server.jar under a JVM (JADX-based, supports --script)",
      "docs": "The reference engine: the JADX-based Kotlin server (decx-server.jar, built in the decx repository). Analyzes APK/DEX/JAR/AAR targets with full Android resource decoding, decompilation to Java source, and Kotlin script support (--script *.jadx.kts, run during decompilation). Extra server arguments after the target pass through verbatim; the server owns their normalization. Install or update the jar with: decx self install.",
      "binary": {
        "kind": "java-jar",
        "path": "decx-server.jar",
        "env": "DECX_SERVER_HOME"
      },
      "launch": {
        "command": ["java", "-Xmx{java_heap}", "-jar", "{binary}", "{target}", "--port", "{port}"],
        "scripts": "positional",
        "trailing_args": true,
        "params": [
          { "id": "port", "long": "--port", "kind": "value", "type": "u16", "help": "HTTP server port (managed by the CLI --port option)", "default": 25419 },
          { "id": "log-level", "long": "--log-level", "kind": "value", "help": "Log level (default INFO)" }
        ]
      }
    },
    {
      "id": "native",
      "description": "decx-native-server (pure-Rust engine, no JVM; --script unsupported)",
      "docs": "The zero-dependency Rust engine (decx-native-server, built in the decx-native workspace): implements every command the jvm server exposes, plus native-only extensions — Kotlin rendering (language=kotlin|auto on source endpoints) and the inter-procedural taint scan (decx java taint-scan, rules replaceable at startup via --taint-rules). Scripts and server passthrough arguments are not supported.",
      "binary": {
        "kind": "program",
        "path": "decx-native-server",
        "env": "DECX_NATIVE_SERVER",
        "exe_suffix": true,
        "search_sibling": true,
        "search_dirs": ["decx-native/target/release"]
      },
      "launch": {
        "command": ["{binary}", "{target}", "--port", "{port}"],
        "params": [
          { "id": "port", "long": "--port", "kind": "value", "type": "u16", "help": "HTTP server port (managed by the CLI --port option)", "default": 25419 },
          { "id": "warm", "long": "--warm", "kind": "flag", "help": "Pre-warm the decompiler at startup" },
          { "id": "taint-rules", "long": "--taint-rules", "kind": "value", "help": "Replace the embedded taint rule set at startup" }
        ]
      }
    },
    {
      "id": "kuna",
      "description": "Kuna binary decompiler served by decx-kuna-server (structural mode)",
      "docs": "The native-binary engine: kuna analyzes raw executables (ELF/PE/Mach-O style binaries) instead of DEX. Structural mode: class-level and function-level source recovery, function search, global key search across functions and strings, and string extraction. Served by decx-kuna-server (built in the decx repository, not in this CLI workspace). Future engines (e.g. ida) plug into the binary tool the same way.",
      "binary": {
        "kind": "program",
        "path": "decx-kuna-server",
        "env": "DECX_KUNA_SERVER",
        "exe_suffix": true,
        "search_sibling": true
      },
      "launch": {
        "command": ["{binary}", "{target}", "--port", "{port}"],
        "params": [
          { "id": "port", "long": "--port", "kind": "value", "type": "u16", "help": "HTTP server port (managed by the CLI --port option)", "default": 25419 }
        ]
      }
    }
  ]
